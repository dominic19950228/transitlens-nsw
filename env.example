# NSW Transit Platform - Environment Variables
# Copy this file to .env and fill in the actual values

# TfNSW API Token (required)
# Get your token from: https://opendata.transport.nsw.gov.au/
TFNSW_API_TOKEN=your_api_token_here

# TfNSW GTFS URL (optional, has default)
TFNSW_GTFS_URL=https://api.transport.nsw.gov.au/v1/publictransport/timetables/complete/gtfs

# Download directory (optional, defaults to ./data/gtfs)
GTFS_DOWNLOAD_DIR=./data/gtfs

# Timeout in milliseconds (optional, defaults to 600000 = 10 minutes)
# GTFS_DOWNLOAD_TIMEOUT_MS=600000
