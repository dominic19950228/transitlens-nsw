DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nsw_transit
DB_CONNECTION_LIMIT=5

# NSW Transit Platform - Environment Variables
# Copy this file to .env and fill in the actual values

# TfNSW API Token (required)
# Get your token from: https://opendata.transport.nsw.gov.au/
TFNSW_API_TOKEN=your_api_token_here

# TfNSW GTFS URL (optional, has default)
TFNSW_GTFS_URL=https://api.transport.nsw.gov.au/v1/publictransport/timetables/complete/gtfs

# Download directory (optional, defaults to ./data/gtfs)
GTFS_DOWNLOAD_DIR=./data/gtfs

# Timeout in milliseconds (optional, defaults to 600000 = 10 minutes)
# GTFS_DOWNLOAD_TIMEOUT_MS=600000

# Extraction directory (optional, defaults to ./data/gtfs/extracted)
GTFS_EXTRACTION_DIR=./data/gtfs/extracted

# Archive resource limits (optional)
# Maximum number of files in archive (optional, defaults to 100)
# GTFS_MAX_ARCHIVE_FILES=100
# Maximum size of single file in bytes (optional, defaults to 10737418240 = 10 GiB)
# GTFS_MAX_SINGLE_FILE_BYTES=10737418240
# Maximum total uncompressed size in bytes (optional, defaults to 21474836480 = 20 GiB)
# GTFS_MAX_TOTAL_UNCOMPRESSED_BYTES=21474836480

# GTFS import batch size for database inserts (optional, defaults to 1000)
GTFS_IMPORT_BATCH_SIZE=1000
